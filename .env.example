# Copy to .env.local (never commit real values).

# PostgreSQL connection string for the development/test database.
# The database must have the PostGIS extension available.
DATABASE_URL=

# MapTiler publishable key for the map shell (TASK-005).
# This is a domain-restricted, client-side key by design, not a secret.
# See docs/adr/0005-map-tile-provider.md. The map shows a literal fallback
# state when this is unset.
NEXT_PUBLIC_MAPTILER_KEY=
