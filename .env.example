# Copy to .env.local (never commit real values).

# PostgreSQL connection string for the development/test database.
# The database must have the PostGIS extension available.
DATABASE_URL=

# No tile-provider key needed: the map shell uses OpenFreeMap, a free,
# keyless OSM vector tile source (docs/adr/0024-openfreemap-tile-provider.md,
# superseding the earlier MapTiler-key setup in docs/adr/0005-map-tile-provider.md).

# Real production domain for metadata/robots/sitemap absolute URLs
# (TASK-027, docs/adr/0022-seo-share-baseline.md), e.g. https://gdziekibel.pl.
# Optional: falls back to Vercel's own auto-provided VERCEL_URL, then to
# http://localhost:3000. No production domain is settled yet, so leave
# unset until one is.
SITE_URL=
